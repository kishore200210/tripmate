# TripMate Environment Variables Template
# Copy this file to .env and configure for development/production.
# NEVER commit the active .env file containing real secrets to version control.

# ── Application Configuration ──────────────────────────────
APP_NAME=TripMate
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=false

# ── Database (PostgreSQL) ──────────────────────────────────
POSTGRES_HOST=your-database-host
POSTGRES_PORT=5432
POSTGRES_USER=your-database-username
POSTGRES_PASSWORD=your-database-password
POSTGRES_DB=your-database-name

# ── Redis (Celery Broker & Cache) ──────────────────────────
REDIS_URL=redis://your-redis-host:6379/0

# ── Security & Authentication (JWT) ────────────────────────
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your-production-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI API Credentials ─────────────────────────────────────
# Groq (Required for itinerary planning & assistant chat)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Optional - needed for RAG knowledge base embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Third-Party API Proxies / Integrations ─────────────────
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest

# ── Cloud Storage (Cloudinary) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Observability & Monitoring ─────────────────────────────
SENTRY_DSN=your-sentry-dsn
LOGFIRE_TOKEN=your-logfire-project-token
