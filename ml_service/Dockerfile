FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and the MLflow database/artifacts generated by train.py
# (In a real production system, mlruns and mlflow.db would be hosted externally, 
# but for this standalone container we package them together)
COPY . .

EXPOSE 8001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
